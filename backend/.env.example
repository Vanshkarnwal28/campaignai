PORT=3001

JWT_SECRET=campaignai_jwt_secret_key_super_secure_2024_v1

# Firebase Admin SDK (required when MOCK_INTEGRATION=false)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
FIREBASE_API_KEY=your_firebase_api_key

MOCK_INTEGRATION=false

# Meta (Facebook / Instagram) Marketing API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/meta/callback
META_WEBHOOK_VERIFY_TOKEN=campaignai_webhook_secret

# AI Models
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Groq AI (Fast LLM fallback - llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Instamojo Payment Gateway Credentials
INSTAMOJO_API_KEY=your_instamojo_api_key
INSTAMOJO_AUTH_TOKEN=your_instamojo_auth_token
INSTAMOJO_PRIVATE_SALT=your_instamojo_private_salt
INSTAMOJO_BASE_URL=https://api.instamojo.com

# Backend & Frontend Public URLs
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Resend (Transactional Email)
RESEND_API_KEY=
